	Local $ACALL = DllCall("user32.dll", "bool", "DrawEdge", "handle", $HDC, "struct*", $TRECT, "uint", $IEDGETYPE, "uint", $IFLAGS)
	If @error Then Return SetError(@error, @extended, False)
	Return $ACALL[0x0]
EndFunc   ;==>_WINAPI_DRAWEDGE
