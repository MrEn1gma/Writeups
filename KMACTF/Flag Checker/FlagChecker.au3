	If StringStripWS($SMODULE, $STR_STRIPLEADING + $STR_STRIPTRAILING) = "" Then $SMODULE = Null
	Local $ACALL = DllCall("kernel32.dll", "bool", "GetModuleHandleExW", "dword", $IFLAGS, "wstr", $SMODULE, "ptr*", 0x0)
