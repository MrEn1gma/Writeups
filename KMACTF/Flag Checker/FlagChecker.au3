	Local $ACALL = DllCall("user32.dll", "hwnd", "GetDesktopWindow")
	If @error Then Return SetError(@error, @extended, 0x0)
	Return $ACALL[0x0]
EndFunc   ;==>_WINAPI_GETDESKTOPWINDOW
