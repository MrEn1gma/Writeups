	DllCall("shell32.dll", "none", "SHUpdateImageW", "wstr", $SICON, "int", $IINDEX, "uint", $IFLAGS, "int", $IIMAGE)
	If @error Then Return SetError(@error, @extended, 0x0)
	Return 0x1
EndFunc   ;==>_WINAPI_SHELLUPDATEIMAGE
