	DllStructSetData($TTME, 0x2, $IFLAGS)
	DllStructSetData($TTME, 0x3, $HWND)
	DllStructSetData($TTME, 0x4, $ITIME)
	Local $ACALL = DllCall("user32.dll", "bool", "TrackMouseEvent", "struct*", $TTME)
