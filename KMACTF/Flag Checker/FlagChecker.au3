	If @error Then Return SetError(@error, @extended, 0x0)
	If ($ACALL[0x0] < 0x1) Or ($ACALL[0x0] > 0x2) Then Return SetError(0xa, $ACALL[0x0], 0x0)
	Return $ACALL[0x0]
EndFunc   ;==>_WINAPI_GETARCDIRECTION
