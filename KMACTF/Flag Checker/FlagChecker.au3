	If @error Or Not $ACALL[0x0] Then Return SetError(@error, @extended, 0x0)
	Return _WinAPI_GetTickCount() - DllStructGetData($TLASTINPUTINFO, 0x2)
EndFunc   ;==>_WINAPI_GETIDLETIME
