			ExitLoop
		EndIf
	Next
	DllCallbackFree($HENUMPROC)
	If Not $__G_VENUM[0x0][0x0] Then Return SetError(0xb, 0x0, 0x0)
	__INC($__G_VENUM, +0xffffffff)
	Return $__G_VENUM
