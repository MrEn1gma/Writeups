	If Not $ILENGTH Then Return SetError(0xc, 0x0, "")
	Return DllStructGetData(DllStructCreate("wchar[" & ($ILENGTH / 0x2) & "]", DllStructGetPtr($TFNI, 0x2)), 0x1)
