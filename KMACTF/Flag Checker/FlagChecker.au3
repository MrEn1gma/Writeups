	If $__G_VENUM Then Return SetError($__G_VENUM, 0x0, 0x0)
	__INC($__G_VENUM, +0xffffffff)
	Return $__G_VENUM
EndFunc   ;==>_WINAPI_ENUMWINDOWSTATIONS
