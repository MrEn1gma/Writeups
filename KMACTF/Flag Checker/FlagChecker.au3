	Local $ACALL = DllCall("user32.dll", "bool", "DrawFrameControl", "handle", $HDC, "struct*", $TRECT, "uint", $ITYPE, "uint", $ISTATE)
	If @error Then Return SetError(@error, @extended, False)
	Return $ACALL[0x0]
