	Local $ACALL = DllCall("kernel32.dll", "bool", "DeviceIoControl", "handle", $HFILE, "dword", 0x2d4808, "ptr", 0x0, "dword", 0x0, "ptr", 0x0, "dword", 0x0, "dword*", 0x0, "ptr", 0x0)
